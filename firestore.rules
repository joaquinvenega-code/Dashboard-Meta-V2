rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Global Security Catch-All
    match /{document=**} {
      allow read, write: if false;
    }

    // Reuseable Securing Helpers
    function isSignedIn() {
      return request.auth != null;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    // Downloads are read-only for the owner. The isolated automation identity
    // may publish/clean only the owner's archive, not their portfolio or sales.
    function isReportPublisher(uid) {
      return isSignedIn() && request.auth.uid == 'orion-weekly-publisher'
        && request.auth.token.weeklyReportsOwner == uid;
    }
    match /orionUsers/{uid}/weeklyReports/{batchId} {
      allow read: if (isSignedIn() && request.auth.uid == uid) || isReportPublisher(uid);
      allow write: if isReportPublisher(uid);
      match /chunks/{chunkId} {
        allow read: if isReportPublisher(uid) || (isSignedIn() && request.auth.uid == uid
          && get(/databases/$(database)/documents/orionUsers/$(uid)/weeklyReports/$(batchId)).data.status == 'ready');
        allow write: if isReportPublisher(uid);
      }
    }

    // Rules for Client collections
    // Each Google-authenticated user owns exactly their portfolio. The private
    // runner reads the chosen owner with its server credential, never from Pages.
    match /orionUsers/{uid}/portfolio/current {
      allow read: if isSignedIn() && request.auth.uid == uid;
      allow create: if isSignedIn() && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['portfolio', 'revision', 'updatedAt'])
        && request.resource.data.portfolio.version == 1
        && request.resource.data.revision == 1;
      allow update: if isSignedIn() && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['portfolio', 'revision', 'updatedAt'])
        && request.resource.data.portfolio.version == 1
        && request.resource.data.revision == resource.data.revision + 1;
      allow delete: if false;
    }

    match /orionUsers/{uid}/clients/{clientId} {
      allow read: if isSignedIn() && request.auth.uid == uid;

      match /logs/{logId} {
        allow read: if isSignedIn() && request.auth.uid == uid;
        allow create, update: if isSignedIn() && request.auth.uid == uid && isValidId(clientId) && isValidId(logId)
          && incoming().text is string && incoming().text.size() <= 5000
          && incoming().date is string && incoming().date.size() <= 20;
        allow delete: if isSignedIn() && request.auth.uid == uid;
      }

      match /offline_sales/{saleId} {
        allow read: if isSignedIn() && request.auth.uid == uid;
        allow create, update: if isSignedIn() && request.auth.uid == uid && isValidId(clientId) && isValidId(saleId)
          && incoming().amount is number && incoming().amount >= 0
          && incoming().date is string && incoming().date.size() <= 20;
        allow delete: if isSignedIn() && request.auth.uid == uid;
      }
    }
  }
}
